  "items": {
    "rubbing": "Charcoal rubbing of the fresh diversion",
    "contract": "Voss’s signed theft contract",
    "charter": "The original peace charter",
    "ledger": "The sealed modern payment ledger"
  },
  "knowledge": {
    "ordan": {
      "title": "The guest’s host",
      "text": "The stranger from the ditch is Ordan, the dragon who kills those delivered under the peace charter."
    },
    "message": {
      "title": "A message north",
      "text": "Sef has been told Edda is alive. He can keep his tools and arrange transport."
    },
    "rubbing": {
      "title": "Fresh tool marks",
      "text": "The rubbing preserves the current diversion before it can be hidden with new stone."
    },
    "linnet": {
      "title": "Linnet",
      "text": "Ordan raised an abandoned infant as his daughter. She grew into a stubborn maker and teacher; she was killed at nineteen."
    },
    "receipts": {
      "title": "People delivered",
      "text": "Twenty-seven receipts acknowledge deaths. Many omit names. Mara Sill is one of those named."
    },
    "change": {
      "title": "Nine heartbeats",
      "text": "Transformation temporarily exposes unarmoured living tissue. Ordan cannot breathe fire while his heat holds the changing shape. The attack exploited this by accident."
    },
    "summerstones": {
      "title": "Stored warmth",
      "text": "Summerstones store dragon heat. They do not hold souls or create healing. Size and iron containment determine the danger of a rapid release."
    },
    "healing": {
      "title": "Care, not a cure",
      "text": "Clean water, protected warmth, rest and Ordan’s own repair closed the wound. His eye is permanently lost. Damaged heat channels remain vulnerable."
    },
    "theft": {
      "title": "A purchased raid",
      "text": "Voss hired Merrow’s company to steal a great summerstone for his works. Their theory of post-sacrifice weakness was wrong."
    },
    "charter": {
      "title": "A voluntary atrocity",
      "text": "No spell compels Ordan. The original revenge bargain became a substitution system that the council used to exploit indebted households."
    },
    "plans": {
      "title": "Independent drawings",
      "text": "Village copies preserve the warning scraped from the council plan. Matched with a fresh rubbing, they can support a preservation order."
    },
    "trial": {
      "title": "A verdict before witnesses",
